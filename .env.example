# Aplicación y autenticación. Estas tres variables son públicas por diseño:
# la seguridad de Supabase depende de Auth + RLS, nunca de ocultar la publishable key.
NEXT_PUBLIC_APP_URL=https://suma-finanzas.vercel.app
NEXT_PUBLIC_SUPABASE_URL=https://project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_example

# Base de datos (solo servidor). Usa DATABASE_URL o POSTGRES_URL, no ambas.
DATABASE_URL=postgresql://user:password@host:5432/database?sslmode=require
# POSTGRES_URL=postgresql://user:password@host:5432/database?sslmode=require

# Google OAuth / Gmail API (solo servidor; nunca usar prefijo NEXT_PUBLIC_).
GOOGLE_CLIENT_ID=example.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=replace_in_vercel_only
GOOGLE_REDIRECT_URI=https://suma-finanzas.vercel.app/api/integrations/gmail/callback

# `openssl rand -base64 32` y conviértelo a Base64URL si corresponde.
TOKEN_ENCRYPTION_KEY=replace_with_32_bytes_base64url
# Al menos 32 caracteres aleatorios para firmar el parámetro state de OAuth.
GMAIL_STATE_SECRET=replace_with_a_long_random_value
# Topic de Gmail watch y autenticación OIDC del push de Pub/Sub.
GMAIL_PUBSUB_TOPIC=projects/example-project/topics/suma-gmail
PUBSUB_AUDIENCE=https://suma-finanzas.vercel.app/api/integrations/gmail/pubsub
PUBSUB_SERVICE_ACCOUNT_EMAIL=suma-pubsub@example-project.iam.gserviceaccount.com

# Solo para desarrollo local de APIs sin sesión. NO configurar en producción.
# APP_SINGLE_USER_ID=local-preview

# RESEND_API_KEY no pertenece a esta aplicación ni a Vercel.
# Para Auth se introduce únicamente como contraseña SMTP en Supabase Dashboard.

